{
  "manifest_version": 3,
  "name": "Goodreads Puanı",
  "version": "1.3",
  "description": "Amazon, Kitapyurdu, D&R, BKM Kitap, Idefix ve diğer kitapçıların kitap sayfalarında Goodreads puanını gösterir.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.goodreads.com/*"
  ],
  "icons": {
      "16": "goodreads-logo16.png",
      "48": "goodreads-logo48.png",
      "128": "goodreads-logo128.png"
  },
  "action": {
      "default_title": "Goodreads Puanı",
      "default_icon": {
          "16": "goodreads-logo16.png",
          "48": "goodreads-logo48.png",
          "128": "goodreads-logo128.png"
      }
  },
  "web_accessible_resources": [
    {
      "resources": ["goodreads-logo.png"],
      "matches": [
        "*://*.amazon.com.tr/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.kitapyurdu.com/*",
        "*://*.dr.com.tr/*",
        "*://*.idefix.com/*",
        "*://*.bkmkitap.com/*",
        "*://*.hepsiburada.com/*",
        "*://*.trendyol.com/*",
        "*://*.pandora.com.tr/*",
        "*://*.babil.com/*",
        "*://*.kitapsec.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com.tr/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.kitapyurdu.com/*",
        "*://*.dr.com.tr/*",
        "*://*.idefix.com/*",
        "*://*.bkmkitap.com/*",
        "*://*.hepsiburada.com/*",
        "*://*.trendyol.com/*",
        "*://*.pandora.com.tr/*",
        "*://*.babil.com/*",
        "*://*.kitapsec.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}